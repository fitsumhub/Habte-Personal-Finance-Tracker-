<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
      Android 11+ hides other apps' package info by default (package visibility) unless
      declared here — this is what lets InstalledBankAppMatcher actually see installed
      launchable apps (to offer as notification-capture sources) without needing the
      Play-Store-restricted QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".HabteApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mobile">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.SummaryAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.PaymentReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.PaymentReminderActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Automated Weekly Spending Digest Widget: displays live weekly budget progress
          and today's total outflow at a glance on the Homescreen and Keyguard / Lockscreen.
        -->
        <!-- 1. Style 1: Weekly Spending Digest Widget -->
        <receiver
            android:name=".data.WeeklySpendingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_spending_digest_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mobile.ACTION_REFRESH_SPENDING_WIDGET" />
                <action android:name="com.mobile.ACTION_UPDATE_SPENDING_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weekly_spending_widget_info" />
        </receiver>

        <!-- 2. Style 2: Net Worth Widget -->
        <receiver
            android:name=".data.NetWorthWidgetProvider"
            android:exported="true"
            android:label="@string/widget_net_worth_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mobile.ACTION_REFRESH_NET_WORTH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/net_worth_widget_info" />
        </receiver>

        <!-- 3. Style 3: Quick Transaction Tracker Widget -->
        <receiver
            android:name=".data.QuickTrackerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_quick_tracker_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mobile.ACTION_REFRESH_QUICK_TRACKER_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_tracker_widget_info" />
        </receiver>

        <!-- 4. Style 4: Multi-Bank Balances Widget -->
        <receiver
            android:name=".data.MultiBankWidgetProvider"
            android:exported="true"
            android:label="@string/widget_multi_bank_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mobile.ACTION_REFRESH_MULTI_BANK_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/multi_bank_widget_info" />
        </receiver>

        <!-- 5. Style 5: Budget Pulse Lockscreen Widget -->
        <receiver
            android:name=".data.BudgetPulseWidgetProvider"
            android:exported="true"
            android:label="@string/widget_budget_pulse_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mobile.ACTION_REFRESH_BUDGET_PULSE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/budget_pulse_widget_info" />
        </receiver>

        <!--
          Only the system can bind to a NotificationListenerService (enforced by this
          android:permission — a normal app can't bind to it directly), and only after the
          user manually grants it in Settings > Notification access (see
          NotificationCaptureScreen, Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS) — that
          OS-level grant is the real consent gate, since Android requires it to be a deliberate
          action in system Settings. Once granted, capture is automatic: onListenerConnected()
          auto-enables every matching bank/wallet app it finds installed (see
          SettingsRepository.autoEnableDetectedApps), no further per-app setup needed. The
          per-package allowlist (SettingsRepository.monitoredApps) is still checked before any
          notification content is read — a notification from any other app is never inspected.
        -->
        <service
            android:name=".data.NotificationCaptureListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Google AdMob Application ID (Habte Financial Tracker Production App ID).
          Configured in AdMob console: ca-app-pub-2695951066960188~8919692609
          Required for Google Mobile Ads SDK initialization.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2695951066960188~8919692609" />

        <!--
          Lets AchievementCertificatesScreen share a generated certificate image/PDF to
          other apps (WhatsApp, Telegram, etc.) via a content:// Uri — a raw file:// Uri
          from internal storage can't be granted to another app on API 24+ (StrictMode
          throws FileUriExposedException). See CertificateExporter.shareIntent and
          res/xml/file_paths.xml for which internal directories are exposed.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>


</manifest>
